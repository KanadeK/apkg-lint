              },
              "id": "MEDIA006",
              "name": "Unusedmedia",
              "shortDescription": {
                "text": "Unused media"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Media filenames collide after Unicode normalization and case folding."
              },
              "id": "MEDIA007",
              "name": "Collidingmediafilenames",
              "shortDescription": {
                "text": "Colliding media filenames"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {

              },
              "id": "MEDIA004",
              "name": "Unsafeornon-portablemediafilename",
              "shortDescription": {
                "text": "Unsafe or non-portable media filename"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A note or template references a local media filename absent from the package."
              },
              "id": "MEDIA005",
              "name": "Referencedmediaismissing",
              "shortDescription": {
                "text": "Referenced media is missing"
              }
            },
            {
              "defaultConfiguration": {

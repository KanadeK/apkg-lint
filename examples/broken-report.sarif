          "rules": [
            {
              "id": "APKG000",
              "name": "PackageReadError",
              "shortDescription": {
                "text": "Package could not be inspected"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "The collection database did not pass SQLite PRAGMA quick_check."
              },
              "id": "PKG001",
              "name": "SQLiteintegritycheckfailed",
              "shortDescription": {
                "text": "SQLite integrity check failed"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "The APKG contains a member not declared by its collection or media map."
              },
              "id": "PKG002",
              "name": "Unmappedarchivemember",
              "shortDescription": {
                "text": "Unmapped archive member"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A card points to a note that is absent from the package."
              },
              "id": "DB001",
              "name": "Orphancard",
              "shortDescription": {
                "text": "Orphan card"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A note references a notetype that is absent from the package."
              },
              "id": "DB002",
              "name": "Missingnotetype",
              "shortDescription": {
                "text": "Missing notetype"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A card references a deck that is absent from the package."
              },
              "id": "DB003",
              "name": "Missingdeck",
              "shortDescription": {
                "text": "Missing deck"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A note has no text or media in its first field."
              },
              "id": "NOTE001",
              "name": "Emptyfirstfield",
              "shortDescription": {
                "text": "Empty first field"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Multiple notes in one notetype normalize to the same first field."
              },
              "id": "NOTE002",
              "name": "Duplicatefirstfield",
              "shortDescription": {
                "text": "Duplicate first field"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A note's field count differs from its notetype definition."
              },
              "id": "NOTE003",
              "name": "Fieldcountmismatch",
              "shortDescription": {
                "text": "Field count mismatch"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A cloze notetype note contains no supported {{cN::...}} marker."
              },
              "id": "CLOZE001",
              "name": "Clozenotehasnodeletion",
              "shortDescription": {
                "text": "Cloze note has no deletion"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "The card ordinals generated for a note do not match its cloze marker numbers."
              },
              "id": "CLOZE002",
              "name": "Clozecardsandmarkersdisagree",
              "shortDescription": {
                "text": "Cloze cards and markers disagree"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A card template references a field that its notetype does not define."
              },
              "id": "TEMPLATE001",
              "name": "Unknowntemplatefield",
              "shortDescription": {
                "text": "Unknown template field"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A normal card template front does not reference any known note field."
              },
              "id": "TEMPLATE002",
              "name": "Templatefronthasnofield",
              "shortDescription": {
                "text": "Template front has no field"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "The media map points to an archive member that does not exist."
              },
              "id": "MEDIA001",
              "name": "Mappedmediamemberismissing",
              "shortDescription": {
